##############################################################################
############################### makefile-OS ##################################
##############################################################################
#                                                                            #
#   makefile of OS-specific settings                                         #
#                                                                            #
#  Defines UNAME_S, which identifies the type of OS, so that the default     #
#  locations of the dependencies on that OS are loaded [see makefile-c]      #
#  without a need for the user to manually edit them. It also gives the      #
#  options of the errors and of the debugging information, in the spelling   #
#  that both clang++ and g++ take, and whether the compiler is clang++,      #
#  which the C++20 modules need [see makefile-mod].                          #
#                                                                            #
#   Input:  $(CC)       = compiler command, looked at when the options are   #
#                         first used, i.e., also if it is defined later      #
#                                                                            #
#   Output: $(UNAME_S)    = the name of the current operating system         #
#           $(SMSppCLANG) = not empty if $(CC) is clang++                    #
#           $(SMSppSWERR) = the option that stops at the first error         #
#           $(SMSppSWDBG) = the option of the debugging information for      #
#                           the debugger, none beyond -g                     #
#                                                                            #
#                              Antonio Frangioni                             #
#                                 Donato Meoli                               #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

# define the macros to be exported- - - - - - - - - - - - - - - - - - - - - -

ifeq ($(OS),Windows_NT)
    UNAME_S := Windows
else
    UNAME_S := $(shell uname -s)
endif

# whether $(CC) is clang++ is asked the first time that it is needed, when
# $(CC) has its final value, and then remembered

SMSppCLANG = $(eval SMSppCLANG := $$(findstring clang,$$(shell $$(CC) \
	--version 2>/dev/null)))$(SMSppCLANG)

# the options of the errors and of the debugging information, which clang++
# and g++ both take

SMSppSWERR = -Wfatal-errors

SMSppSWDBG =

############################# End of makefile ################################
