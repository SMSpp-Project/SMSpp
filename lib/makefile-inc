##############################################################################
############################### makefile-inc #################################
##############################################################################
#                                                                            #
#   makefile of libSMS++ as a pre-built library                              #
#                                                                            #
#   Input:  $(SMS++SDR) = the directory where the core SMS++ source is       #
#                                                                            #
#   Output: accordingly, there is no in output, since there is no need to    #
#           check for changes in the .h and rebuild the .o / .a. Also, the   #
#           *OBJ is just the library                                         #
#           $(SMS++INC) = the -I$(include directories) for SMS++             #
#           $(SMS++LIB) = external libreries + -L<libdirs> for SMS++         #
#           $(SMS++OBJ) = the libSMS++ library itself                        #
#                                                                            #
#   Indeed, the makefile only calls makefile-c and strips away the *H and    #  
#   *OBJ macros. This is not even necessary, it is only made for clarity.    #
#                                                                            #
#                                VERSION 1.00                                #
#                               12 - 11 - 2018                               #
#                                                                            #
#                              Antonio Frangioni                             #
#                          Operations Research Group                         #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#									     #
##############################################################################

# include the SMS++ makefile internally defining all external modules - - - -

include $(SMS++SDR)lib/makefile-c

# re-define the OBJ as the library- - - - - - - - - - - - - - - - - - - - - -

SMS++OBJ = $(SMS++SDR)lib/libSMS++.a

# ensure that the library is properly constructed - - - - - - - - - - - - - -

$(SMS++OBJ):
	make -f $(SMS++SDR)lib/makefile-lib SMS++SDR=$(SMS++SDR)

# clean-up unrequired things- - - - - - - - - - - - - - - - - - - - - - - - -

SMS++H =

# clean - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

clean::
	make -f $(SMS++SDR)lib/makefile-lib clean SMS++SDR=$(SMS++SDR) 

########################## End of makefile-inc ###############################
