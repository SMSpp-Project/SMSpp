# --------------------------------------------------------------------------- #
# SMSppModule.cmake                                                           #
#                                                                             #
# The functions with which an SMS++ module, its tests and its tools build     #
# the same way everywhere, with no test on the system or on the compiler:     #
#   - smspp_install_rpath() makes the installed libraries and programs look   #
#     for the libraries of the same installation relative to their own        #
#     location;                                                               #
#   - smspp_keep_module(<target> [<name> ...]) makes whoever links <target>   #
#     call SMSpp_force_load_<name>() (<name> is <target> if none is given),   #
#     so that every linker keeps the library, whose classes register          #
#     themselves in the factories from static objects that nothing names;     #
#   - smspp_keep_modules() makes the programs and libraries of the calling    #
#     directory and of those below it link whole the static libraries they    #
#     link, for the same reason;                                              #
#   - smspp_copy_runtime(<target>) copies next to <target> the DLLs it needs, #
#     where there are any;                                                    #
#   - smspp_plugin(<target> [EXPORT <set>]) makes the shared library <target> #
#     a plugin, which a program loads when it asks the factory for one of     #
#     its classes, and SMSpp_PLUGIN_DIR is where the build tree has them;     #
#   - SMSpp_BASH is the bash that runs the scripts of the tests;              #
#   - SMSpp_CMAKE_DIR is the directory of this file, and of the find modules  #
#     that the modules share (e.g., FindCPLEX.cmake).                         #
#                                                                             #
# The umbrella and the core include it, and so does the package               #
# configuration file of the core, so that a module finds it both inside the   #
# umbrella and with find_package().                                           #
# --------------------------------------------------------------------------- #

include(GNUInstallDirs)

set(SMSpp_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}" CACHE INTERNAL
        "The directory of the CMake files of SMS++")

# ----- RPATH --------------------------------------------------------------- #
# The directories of the external libraries are kept. CMake gives the token
# of the directory of the loaded file where the dynamic linker has $ORIGIN,
# and has none for the @loader_path of the other one, ld64; where there is no
# run-time path (the DLLs) the entries are ignored.
macro(smspp_install_rpath)
    if (NOT CMAKE_INSTALL_RPATH)
        set(_smspp_origin "${CMAKE_SHARED_LIBRARY_RPATH_ORIGIN_TOKEN}")
        if (NOT _smspp_origin)
            set(_smspp_origin "@loader_path")
        endif ()
        file(RELATIVE_PATH _smspp_bin_to_lib ${CMAKE_INSTALL_FULL_BINDIR}
                ${CMAKE_INSTALL_FULL_LIBDIR})
        set(CMAKE_INSTALL_RPATH "${_smspp_origin}"
                "${_smspp_origin}/${_smspp_bin_to_lib}")
        unset(_smspp_origin)
        unset(_smspp_bin_to_lib)
    endif ()
    set(CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)
endmacro()

# ----- Keeping the shared libraries ---------------------------------------- #
# A source compiled into each target that links <target> calls the
# functions from a static object: a library that provides a symbol to a
# regular object of the link is kept by every linker. The source is
# installed next to the package configuration file of the module.
function(smspp_keep_module target)
    set(_names ${ARGN})
    if (NOT _names)
        set(_names ${target})
    endif ()
    set(_decl "")
    set(_call "")
    foreach (_name IN LISTS _names)
        string(APPEND _decl
                "extern \"C\" void SMSpp_force_load_${_name}( void );\n")
        string(APPEND _call "  SMSpp_force_load_${_name}();\n")
    endforeach ()
    set(_file ${target}KeepModule.cpp)
    file(CONFIGURE OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${_file} CONTENT
"// generated by smspp_keep_module() [see SMSppModule.cmake of SMS++]
@_decl@
namespace {
 struct SMSpp_keep_module {
  SMSpp_keep_module( void ) {
@_call@  }
  } SMSpp_keep_module_object;
 }
" @ONLY)
    set(_dest ${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME})
    target_sources(${target} INTERFACE
            $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/${_file}>
            $<INSTALL_INTERFACE:${_dest}/${_file}>)
    install(FILES ${CMAKE_CURRENT_BINARY_DIR}/${_file} DESTINATION ${_dest})
    _smspp_module_plugin(${target})
endfunction()

# ----- Keeping the static libraries ---------------------------------------- #
# A static library loses the objects that nothing names, and with them the
# registrations, unless it is linked whole: at the end of the configuration,
# when every target is defined, each program and library of the directory
# links with the WHOLE_ARCHIVE feature of CMake the static libraries it
# reaches through its links, its own and those of SMS++. With shared
# libraries there are none.
function(smspp_keep_modules)
    cmake_language(DEFER DIRECTORY ${CMAKE_SOURCE_DIR}
            CALL _smspp_keep_modules_in "${CMAKE_CURRENT_SOURCE_DIR}")
endfunction()

# appends to the variable out the static libraries that the items link
function(_smspp_static_closure out)
    set(_found ${${out}})
    foreach (_item IN LISTS ARGN)
        string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" _item "${_item}")
        if ((_item MATCHES "\\$<") OR (NOT TARGET ${_item})
                OR (_item IN_LIST _found))
            continue()
        endif ()
        get_target_property(_real ${_item} ALIASED_TARGET)
        if (NOT _real)
            set(_real ${_item})
        endif ()
        list(APPEND _found ${_item} ${_real})
        # those of the build and the installed SMS++ ones, not the archives
        # of the other packages
        get_target_property(_type ${_real} TYPE)
        get_target_property(_imported ${_real} IMPORTED)
        if ((_type STREQUAL "STATIC_LIBRARY") AND ((NOT _imported)
                OR (_item MATCHES "^SMS\\+\\+::")))
            set_property(GLOBAL APPEND PROPERTY _SMSpp_STATIC
                    ${_item} ${_real})
        endif ()
        get_target_property(_links ${_real} INTERFACE_LINK_LIBRARIES)
        if (_links)
            _smspp_static_closure(_found ${_links})
        endif ()
    endforeach ()
    set(${out} ${_found} PARENT_SCOPE)
endfunction()

function(_smspp_keep_modules_in dir)
    get_property(_subdirs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
    foreach (_sub IN LISTS _subdirs)
        _smspp_keep_modules_in(${_sub})
    endforeach ()
    get_property(_targets DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
    foreach (_target IN LISTS _targets)
        get_target_property(_type ${_target} TYPE)
        if (NOT _type MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$")
            continue()
        endif ()
        set_property(GLOBAL PROPERTY _SMSpp_STATIC "")
        get_target_property(_links ${_target} LINK_LIBRARIES)
        if (_links)
            set(_seen "")
            _smspp_static_closure(_seen ${_links})
        endif ()
        get_property(_static GLOBAL PROPERTY _SMSpp_STATIC)
        if (_static AND CMAKE_VERSION VERSION_LESS 3.30)
            # an older CMake repeats an archive that a cycle of the links
            # repeats, whole, hence with its symbols defined twice
            message(FATAL_ERROR "${_target} links static SMS++ libraries, "
                    "which have to be linked whole, once each: this needs "
                    "CMake 3.30 or later, or the shared libraries")
        endif ()
        if (_static)
            list(REMOVE_DUPLICATES _static)
            list(JOIN _static "," _static)
            set_property(TARGET ${_target} APPEND PROPERTY
                    LINK_LIBRARY_OVERRIDE "WHOLE_ARCHIVE,${_static}")
        endif ()
    endforeach ()
endfunction()

# ----- Run-time dependencies ----------------------------------------------- #
# The command is there only where the target needs DLLs (e.g., not inside a
# conda build, whose environment has them), and copies them one target at a
# time, since two copies of the same DLL into a directory collide.
function(smspp_copy_runtime target)
    if (DEFINED ENV{CONDA_BUILD})
        return()
    endif ()
    set(_dlls $<TARGET_RUNTIME_DLLS:${target}>)
    set(_script ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/SMSppCopyRuntime.cmake)
    add_custom_command(TARGET ${target} POST_BUILD
            COMMAND "$<$<BOOL:${_dlls}>:${CMAKE_COMMAND};\
-DSMSpp_FILES=$<JOIN:${_dlls},?>;\
-DSMSpp_DESTINATION=$<TARGET_FILE_DIR:${target}>;-P;${_script}>"
            COMMAND_EXPAND_LISTS
            VERBATIM)
endfunction()

# ----- Plugins ------------------------------------------------------------- #
# A plugin is a shared library that a program loads when it asks the factory
# for a class that it registers [see SMSpp_load_plugin() in SMSFactory.h],
# found in a table (a .smspp file) that the tool of the core writes after
# the link, with the classes that the library registers and that the shared
# libraries it reaches through its links do not, which the tool loads first.
# smspp_plugin() makes a plugin of a library that nothing links (e.g., a
# backend with a dependency that may be missing): it goes in
# SMSpp_PLUGIN_DIR, with its table next to it, and is installed with the
# libraries, a DLL too, since it is loaded by its path. The shared library
# of a module, which programs also link, is a plugin as well, where it is
# built and installed: by smspp_keep_module() its table goes in
# SMSpp_PLUGIN_DIR and next to the library, and is installed with it. A
# static library is no plugin.
set(SMSpp_PLUGIN_DIR "${CMAKE_BINARY_DIR}/plugins" CACHE PATH
        "The directory of the plugins of the build tree")

# appends to the variable out the targets that the items link, and to the
# variable files the files of the shared libraries among them
function(_smspp_shared_closure out files)
    set(_found ${${out}})
    set(_files ${${files}})
    foreach (_item IN LISTS ARGN)
        string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" _item "${_item}")
        if ((_item MATCHES "\\$<") OR (NOT TARGET ${_item})
                OR (_item IN_LIST _found))
            continue()
        endif ()
        get_target_property(_real ${_item} ALIASED_TARGET)
        if (NOT _real)
            set(_real ${_item})
        endif ()
        list(APPEND _found ${_item} ${_real})
        get_target_property(_type ${_real} TYPE)
        if (_type STREQUAL "SHARED_LIBRARY")
            list(APPEND _files "$<TARGET_FILE:${_real}>")
        endif ()
        get_target_property(_links ${_real} INTERFACE_LINK_LIBRARIES)
        if (_links)
            _smspp_shared_closure(_found _files ${_links})
        endif ()
    endforeach ()
    set(${out} ${_found} PARENT_SCOPE)
    set(${files} ${_files} PARENT_SCOPE)
endfunction()

# the shared libraries to be loaded before the plugin target, at the end of
# the configuration, when every target that it links is defined
function(_smspp_plugin_preload target)
    set(_seen "")
    set(_libs "")
    get_target_property(_links ${target} LINK_LIBRARIES)
    if (_links)
        _smspp_shared_closure(_seen _libs ${_links})
    endif ()
    list(REMOVE_DUPLICATES _libs)
    set_property(TARGET ${target} PROPERTY SMSpp_PLUGIN_PRELOAD "${_libs}")
endfunction()

# writes after the link of target the tables given, by SMSppPluginTable.cmake,
# with the tool of the SMS++ of the build, which may be defined later, or of
# the installed one
function(_smspp_plugin_tables target)
    if (CMAKE_CROSSCOMPILING)
        return()
    endif ()
    set(_installed FALSE)
    if (TARGET SMS++::SMS++)
        get_target_property(_installed SMS++::SMS++ IMPORTED)
    endif ()
    if (_installed)
        if (NOT TARGET SMS++::smspp_plugin_names)
            return()
        endif ()
    else ()
        add_dependencies(${target} smspp_plugin_names)
    endif ()
    cmake_language(EVAL CODE "cmake_language(DEFER DIRECTORY \
            [[${CMAKE_SOURCE_DIR}]] CALL _smspp_plugin_preload [[${target}]])")
    set(_pre "$<TARGET_PROPERTY:${target},SMSpp_PLUGIN_PRELOAD>")
    set(_pre "$<TARGET_GENEX_EVAL:${target},${_pre}>")
    set(_script ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/SMSppPluginTable.cmake)
    add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND}
            "-DSMSpp_TOOL=$<TARGET_FILE:SMS++::smspp_plugin_names>"
            "-DSMSpp_TABLES=$<JOIN:${ARGN},?>"
            "-DSMSpp_PLUGIN=$<TARGET_FILE:${target}>"
            "-DSMSpp_LIBRARIES=$<JOIN:${_pre},?>"
            "-DSMSpp_DLLS=$<JOIN:$<TARGET_RUNTIME_DLLS:${target}>,?>"
            -P ${_script}
            VERBATIM)
endfunction()

function(smspp_plugin target)
    cmake_parse_arguments(_plugin "" "EXPORT" "" ${ARGN})
    get_target_property(_type ${target} TYPE)
    if (NOT _type STREQUAL "SHARED_LIBRARY")
        return()
    endif ()
    set_target_properties(${target} PROPERTIES
            LIBRARY_OUTPUT_DIRECTORY "${SMSpp_PLUGIN_DIR}"
            RUNTIME_OUTPUT_DIRECTORY "${SMSpp_PLUGIN_DIR}")
    set(_table "$<TARGET_FILE_DIR:${target}>/")
    string(APPEND _table "$<TARGET_FILE_BASE_NAME:${target}>.smspp")
    _smspp_plugin_tables(${target} "${_table}")

    if (_plugin_EXPORT)
        set(_export EXPORT ${_plugin_EXPORT})
    endif ()
    install(TARGETS ${target} ${_export}
            RUNTIME DESTINATION ${CMAKE_INSTALL_LIBDIR}
            LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
            ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
    install(FILES "${_table}" DESTINATION ${CMAKE_INSTALL_LIBDIR})
endfunction()

# the tables of the library of a module [see smspp_keep_module()]
function(_smspp_module_plugin target)
    get_target_property(_type ${target} TYPE)
    if (NOT _type STREQUAL "SHARED_LIBRARY")
        return()
    endif ()
    set(_name "$<TARGET_FILE_BASE_NAME:${target}>.smspp")
    set(_table "$<TARGET_FILE_DIR:${target}>/${_name}")
    _smspp_plugin_tables(${target} "${SMSpp_PLUGIN_DIR}/${_name}" "${_table}")
    # next to the library, a DLL among the programs
    if (WIN32)
        set(_dest ${CMAKE_INSTALL_BINDIR})
    else ()
        set(_dest ${CMAKE_INSTALL_LIBDIR})
    endif ()
    install(FILES "${_table}" DESTINATION ${_dest} OPTIONAL)
endfunction()

