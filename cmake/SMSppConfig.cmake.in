# This file contains instructions on how to generate the SMSppConfig.cmake file

get_filename_component(SMSpp_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
include(CMakeFindDependencyMacro)

#list(APPEND CMAKE_MODULE_PATH ${SMSpp_CMAKE_DIR})

find_package(Boost REQUIRED)
find_package(Eigen3 REQUIRED)
#list(REMOVE_AT CMAKE_MODULE_PATH -1)

if(NOT TARGET SMS++::SMSpp)
    include("${SMSpp_CMAKE_DIR}/SMSppTargets.cmake")
endif()

set(SMSpp_LIBRARIES SMS++::SMSpp)
